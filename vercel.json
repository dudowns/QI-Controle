{
    "installCommand": "flutter pub get",
    "buildCommand": "flutter build web --release --base-href=\"/\"",
    "outputDirectory": "build/web",
    "builds": [
        {
            "src": "build/web/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}